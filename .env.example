# TRACEFORGE AI Configuration

# Application
APP_NAME="TRACEFORGE AI"
APP_ENV=development
DEBUG=true

# FalkorDB Graph Database Configuration
# Local Docker instance: docker run -p 6379:6379 -it --rm falkordb/falkordb:latest
# Or FalkorDB Cloud endpoint
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=traceforge_incidents

# LLM Provider Configuration
# Options: demo, openai, anthropic, gemini, groq, ollama
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=deterministic-reasoning-engine
LLM_BASE_URL=

# Deterministic Demo Mode (Works out-of-the-box without external keys)
DEMO_MODE=true

# Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]
